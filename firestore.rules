rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for authentication and ownership
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Top-level User Document (Business Profile & Settings)
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);

      // Customers Subcollection (Strictly isolated to authenticated business owner)
      match /customers/{customerId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.ownerId == userId
          && (!('businessId' in request.resource.data) || request.resource.data.businessId == userId);
        allow update: if isOwner(userId)
          && request.resource.data.ownerId == resource.data.ownerId
          && (!('businessId' in request.resource.data) || request.resource.data.businessId == resource.data.businessId);
        allow delete: if isOwner(userId);
      }

      // Dues Subcollection (Strictly isolated to authenticated business owner)
      match /dues/{dueId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.ownerId == userId
          && (!('businessId' in request.resource.data) || request.resource.data.businessId == userId);
        allow update: if isOwner(userId)
          && request.resource.data.ownerId == resource.data.ownerId
          && (!('businessId' in request.resource.data) || request.resource.data.businessId == resource.data.businessId);
        allow delete: if isOwner(userId);
      }

      // Payments Subcollection (Strictly isolated to authenticated business owner)
      match /payments/{paymentId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.ownerId == userId
          && (!('businessId' in request.resource.data) || request.resource.data.businessId == userId);
        allow update: if isOwner(userId)
          && request.resource.data.ownerId == resource.data.ownerId
          && (!('businessId' in request.resource.data) || request.resource.data.businessId == resource.data.businessId);
        allow delete: if isOwner(userId);
      }

      // Recurring Due Schedules Subcollection (Strictly isolated to authenticated business owner)
      match /recurring_due_schedules/{scheduleId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.ownerId == userId
          && (!('businessId' in request.resource.data) || request.resource.data.businessId == userId);
        allow update: if isOwner(userId)
          && request.resource.data.ownerId == resource.data.ownerId
          && (!('businessId' in request.resource.data) || request.resource.data.businessId == resource.data.businessId);
        allow delete: if isOwner(userId);
      }
    }
  }
}
