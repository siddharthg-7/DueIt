rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Top-level User Document (Business profile & settings)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Customers Subcollection (Scoped strictly to the authenticated business owner)
      match /customers/{customerId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Future subcollections (dues, payments, reminders) scoped to user
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
